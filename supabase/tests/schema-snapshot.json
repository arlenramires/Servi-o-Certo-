  "functions": [
    "CREATE OR REPLACE FUNCTION public.accept_request(p_request_id uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare claimed boolean;\nbegin\nif not exists(select 1 from public.profiles p where p.id=(select auth.uid()) and p.role='prestador' and p.is_available) then\nreturn false;\nend if;\nupdate public.service_requests r\nset provider_id=(select auth.uid()),status='aceito'\nwhere r.id=p_request_id and r.status='aberto' and r.provider_id is null\nand exists (\nselect 1 from public.professions prof\njoin public.provider_professions pp on pp.profession_id=prof.id and pp.provider_id=(select auth.uid()) and pp.verification_status='verificado'\njoin public.profession_compliance_rules cr on cr.profession_id=prof.id and cr.classification<>'unreviewed' and cr.reviewed_at is not null\nwhere prof.normalized_name=lower(btrim(r.profession))\n)\nreturning true into claimed;\nreturn coalesce(claimed,false);\nend;\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.available_requests()\n RETURNS TABLE(request_id uuid, requested_profession text, requested_at timestamp with time zone)\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nselect r.id,r.profession,r.created_at\nfrom public.service_requests r\njoin public.professions prof on prof.normalized_name=lower(btrim(r.profession))\njoin public.provider_professions pp on pp.profession_id=prof.id and pp.provider_id=(select auth.uid()) and pp.verification_status='verificado'\njoin public.profession_compliance_rules cr on cr.profession_id=prof.id and cr.classification<>'unreviewed' and cr.reviewed_at is not null\nwhere r.status='aberto' and r.provider_id is null\nand exists(select 1 from public.profiles p where p.id=(select auth.uid()) and p.role='prestador' and p.is_available)\norder by r.is_urgent desc,r.created_at asc limit 30\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.create_profession_compliance_default()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n insert into public.profession_compliance_rules(profession_id,classification)\n values(new.id,'unreviewed')\n on conflict(profession_id) do nothing;\n return new;\nend;\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.handle_new_service_certo_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  insert into public.profiles (id, full_name, role, is_available)\n  values (new.id, left(nullif(btrim(coalesce(new.raw_user_meta_data->>'full_name','')), ''), 150), 'cliente', false)\n  on conflict (id) do nothing;\n  return new;\nend;\n$function$\n",
    "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  insert into public.profiles (id, full_name, role)\n  values (\n    new.id,\n    left(coalesce(new.raw_user_meta_data ->> 'full_name',''),150),\n    case when new.raw_user_meta_data ->> 'account_type' = 'prestador' then 'prestador' else 'cliente' end\n  );\n  return new;\nend;\n$function$\n"
  ],
  "triggers": [
    "CREATE TRIGGER on_auth_user_created AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION handle_new_user()",
    "CREATE TRIGGER on_service_certo_auth_user_created AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION handle_new_service_certo_user()",
    "CREATE TRIGGER trg_profession_compliance_default AFTER INSERT ON public.professions FOR EACH ROW EXECUTE FUNCTION create_profession_compliance_default()"
  ],
